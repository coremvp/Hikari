{
  "name": "hikari",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts ./tests",
    "format": "prettier --write src tests scripts e2e *.ts *.mjs *.json README.md",
    "test:integration": "bun --conditions=react-server scripts/proof-db.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.12",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "stripe": "23.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "supabase": "2.119.0"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
